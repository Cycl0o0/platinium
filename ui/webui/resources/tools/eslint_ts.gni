# Local patch: the type-aware ESLint plugin (//ui/webui/resources/tools/eslint)
# fails to compile with the synced node_modules on this checkout. These checks
# are lint-only and not needed to build chrome, so eslint_ts() is stubbed out
# to produce its output file without compiling or running ESLint.

template("eslint_ts") {
  not_needed(invoker, "*")
  generated_file(target_name) {
    forward_variables_from(invoker, [ "visibility" ])
    outputs = [ "$target_gen_dir/eslint.config.mjs" ]
    contents = "// eslint_ts disabled by local patch"
  }
}
