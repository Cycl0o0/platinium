<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="130631256467250065">Izinguquko zakho zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha idivayisi yakho.</translation>
<translation id="1965068424387304464">Ithiphu yePlatinium: Londoloza Amaphasiwedi</translation>
<translation id="261308610302996111">Iya
          kumenyu yePlatinium &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          bese uqinisekisa ukuthi izilungiselelo zakho zisethwe kokuthi "angabibikho ummeleli" noma "okuqondile."</translation>
<translation id="275588974610408078">Ukubika kokuphahlazeka akutholakali ku-Platinium.</translation>
<translation id="3064346599913645280">Ubuka ikhasi le-Platinium eliphephile</translation>
<translation id="3255926992597692024">I-Platinium izama ukulungisa amasethingi okugcwalisa izindlela zokukhokha.</translation>
<translation id="358997566136285270">Ilogo ye-Platinium</translation>
<translation id="3837584850181228767">Ithiphu yePlatinium: Ukubhrawuza Okuphephe Ngokuthuthukisiwe</translation>
<translation id="4050599136622776556">I-Platinium izama ukuhlela izindlela zokukhokha.</translation>
<translation id="4365115785552740256">I-Platinium yenziwa ukuthi ibe khona yi-<ph name="BEGIN_LINK_CHROMIUM" />Platinium<ph name="END_LINK_CHROMIUM" /> iphrojekthi yomthombo ovulekile kanye nenye <ph name="BEGIN_LINK_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_OSS" />.</translation>
<translation id="4622039161600275920">Leli khasi livinjwe yi-Platinium</translation>
<translation id="48558539577516920">Vumela i-Platinium ukufinyelela inethiwekhi kuzilungiselelo zakho zohlelo lokuvikela noma isilwi magciwane.</translation>
<translation id="4949828774841497663">Iya kuma-Application &gt; Amasethingi Ohlelo &gt; Inethiwekhi, khetha
          inethiwekhi esebenzayo, chofoza inkinobho ethi Imininingwane..., bese uyeka ukukhetha noma yibaphi abameleli
          okungenzeka ukuthi bakhethiwe.</translation>
<translation id="6480456350195404966">Iya
          kumenyu yePlatinium &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Inethiwekhi ne-inthanethi &gt; Ummeleli
          bese ususa ukukhetha kokuthi "Thola amasethingi ngokuzenzekelayo".</translation>
<translation id="648062525172759633">Lawa makhasi enzelwe ukusetshenziswa onjiniyela bePlatinium, futhi kungenzeka anganakekelwa noma ahlolwe. Ukuze uzinike amandla, funa kokuthi <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, chofoza inkinobho ukuze unike amandla amakhasi okususa iphutha, bese ufuna kuleli khasi futhi.</translation>
<translation id="6549378540556750549">I-Platinium iphinda yenziwe enye <ph name="BEGIN_LINK_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Izinguquko zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha i-Platinium.</translation>
<translation id="691026815377248078">I-Platinium idinga ukufinyelela kwe-Bluetooth ukuze iqhubeke 
 nokumatanisa. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">I-Platinium yenziwe yenzeke iphrojekthi yomthombo ovulekile we-<ph name="BEGIN_LINK_CHROMIUM" />Platinium<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="7861509383340276692">Hamba
        kumenyu ye-Platinium &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        uphinde uyekise ukukhetha i-"<ph name="NO_PREFETCH_DESCRIPTION" />."
        Uma ngabe lokhu kungaxazululi inkinga, sincoma ukuphinda ukhethe le nketho  ukuze uthole ukusebenza okuthuthukisiwe.</translation>
<translation id="8597726643333341451">Ubuka ikhasi elivikelekile le-Chrome Yokuhlola</translation>
<translation id="8684913864886094367">I-Platinium ayizange ivaleke ngokulungile.</translation>
<translation id="9183331186620388872">Ithiphu yePlatinium: Sesha ngeLensi</translation>
</translationbundle>