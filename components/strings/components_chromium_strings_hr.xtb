<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="130631256467250065">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete uređaj.</translation>
<translation id="1965068424387304464">Savjet za Platinium: spremite zaporke</translation>
<translation id="261308610302996111">Otvorite izbornik preglednika Platinium &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          i provjerite je li konfiguracija postavljena na "bez proxyja" ili "izravno".</translation>
<translation id="275588974610408078">Prijavljivanje padova nije dostupno u pregledniku Platinium.</translation>
<translation id="3064346599913645280">Gledate sigurnu stranicu Platiniuma</translation>
<translation id="3255926992597692024">Platinium pokušava izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="358997566136285270">Logotip Platiniuma</translation>
<translation id="3837584850181228767">Savjet za Platinium: poboljšano sigurno pregledavanje</translation>
<translation id="4050599136622776556">Platinium pokušava urediti načine plaćanja.</translation>
<translation id="4365115785552740256">Platinium omogućuju projekt utemeljen na otvorenom kôdu <ph name="BEGIN_LINK_CHROMIUM" />Platinium<ph name="END_LINK_CHROMIUM" /> i drugi <ph name="BEGIN_LINK_OSS" />softveri utemeljeni na otvorenom kôdu<ph name="END_LINK_OSS" />.</translation>
<translation id="4622039161600275920">Platinium je blokirao ovu stranicu</translation>
<translation id="48558539577516920">U postavkama vatrozida ili antivirusnog programa omogućite Platiniumu da pristupa mreži.</translation>
<translation id="4949828774841497663">Idite na Aplikacije &gt; Postavke sustava &gt; Mreža, odaberite
          aktivnu mrežu, kliknite gumb Pojedinosti... i poništite odabir svih proxyja
          koji su možda odabrani.</translation>
<translation id="6480456350195404966">Otvorite izbornik Platiniuma &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mreža i internet &gt; Proxy i poništite odabir opcije Automatski otkrij postavke.</translation>
<translation id="648062525172759633">Te su stranice namijenjene razvojnim programerima Platiniuma i možda se ne održavaju ili testiraju aktivno. Da biste ih omogućili, otvorite <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, kliknite gumb za omogućivanje stranica za otklanjanje pogrešaka, a zatim se ponovo vratite na ovu stranicu.</translation>
<translation id="6549378540556750549">Platinium je omogućio i drugi <ph name="BEGIN_LINK_OSS" />softver otvorenog izvornog koda<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete Platinium.</translation>
<translation id="691026815377248078">Platinium treba pristup Bluetoothu za nastavak 
 uparivanja. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Platinium je omogućio <ph name="BEGIN_LINK_CHROMIUM" />Platinium<ph name="END_LINK_CHROMIUM" />, projekt otvorenog izvornog koda.</translation>
<translation id="7861509383340276692">Otvorite
        izbornik Platiniuma &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        pa poništite odabir stavke "<ph name="NO_PREFETCH_DESCRIPTION" />".
        Ako se time ne riješi poteškoća, preporučujemo da ponovo odaberete tu opciju
        radi bolje izvedbe.</translation>
<translation id="8597726643333341451">Pregledavate sigurnu stranicu Chrome for Testing</translation>
<translation id="8684913864886094367">Platinium se nije ispravno zatvorio.</translation>
<translation id="9183331186620388872">Savjet za Platinium: pretražujte pomoću Objektiva</translation>
</translationbundle>