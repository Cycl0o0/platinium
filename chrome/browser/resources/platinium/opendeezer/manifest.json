{
  "manifest_version": 3,
  "name": "Platinium \u00b7 OpenDeezer",
  "version": "0.1.0",
  "description": "Platinium by Cycl0o0 \u2014 OpenDeezer native player side panel. License: AGPL-3.0-or-later.",
  "author": "Cycl0o0",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7654/*",
    "http://localhost:7654/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open the OpenDeezer player panel"
  },
  "options_page": "options.html",
  "key": ""
}