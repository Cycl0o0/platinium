<translation id="7450541714075000668">ጽሁፍ ገልብጧል</translation>
<translation id="7458892263350425044">ማይክሮፎንዎን ለመጠቀም <ph name="BEGIN_LINK" />የሥርዓት ቅንብሮች<ph name="END_LINK" /> ውስጥ ለPlatinium መዳረሻ ይስጡ</translation>
<translation id="7461356015007898716">የወደፊት የPlatinium ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 7ን እየተጠቀመ ነው።</translation>
<translation id="7467949745582939695">Platinium ዳግም ይጀመር?</translation>
<translation id="7483335560992089831">እየሄደ ያለውን ተመሳሳዩን የPlatinium ስሪት መጫን አይቻልም። እባክዎ Platiniumን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="7510190804000607802">አስታዋሽ፦ የGoogle ምርጡ በኪስዎ ውስጥ</translation>
<translation id="751935028865900641">ጣቢያዎች እንደተጠበቀው መስራታቸው አይቀርም። ከGoogle መለያዎ በስተቀር በ Platinium ውስጥ ገብተው ከሆነ፣ ሁሉንም የPlatinium መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ።</translation>
<translation id="753534427205733210">{0,plural, =1{Platinium በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{Platinium በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{Platinium በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="7565444033145385702">ውሂብዎን ለመጠበቅ Platinium እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች ላይ ፈቃዶችን እንዲያስወግድ ይፍቀዱ።</translation>
<translation id="7583104404158659071">በቅጽበት ማሰስ ለመጀመር Platiniumን በራስ-ሰር አስጀምር።</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ጫኝ</translation>
<translation id="761356813943268536">Platinium ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="7617377681829253106">Platinium አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="7622753900276619808">አሁን Platinium ውስጥ የሚገኙ ተጨማሪ ባህሪያት አሉዎት</translation>
<translation id="7624307931717240213">ይህን አገልግሎት ለማሻሻል መረጃ እንጠቀማለን። የግላዊነት መመሪያን እና የአገልግሎት ውልን ይመልከቱ።</translation>
