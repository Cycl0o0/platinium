<translation id="2753623023919742414">ለመፈለግ ጠቅ ያድርጉ</translation>
<translation id="2768103863314748511">Platiniumን እንደ ነባሪ ፒዲኤፍ መመልከቻዎ ያቀናብሩ</translation>
<translation id="2785438272836277133">ይህ ቅጥያ ተንኮል አዘል ዌርን ይዟል እና ደህንነቱ የተጠበቀ አይደለም። የግል መረጃዎን ጨምሮ ከእንግዲህ እርስዎ በሚጎበኟቸው ጣቢያዎች ላይ ያለዎን ውሂብ ማየት እና መለወጥ እንዳይችል ከPlatinium ያስወግዱት።</translation>
<translation id="2799223571221894425">ዳግም አስጀምር</translation>
<translation id="2803971713792056305">የእርስዎ Platinium</translation>
<translation id="2816462166102338036">ይህን ቪድዮ በምስል ፍለጋ ይፈልጉ</translation>
<translation id="282591729717417030">በካሜራዎ ምርቶችን ያግኙ፣ የዋጋ ቅነሳዎችን ይከታተሉ እና በiOS ላይ በPlatinium በመሄድ ላይ ሳሉ ሌሎችንም ያድርጉ።</translation>
<translation id="2841525013647267359">ተርጉም ከ</translation>
<translation id="2846251086934905009">የጭነት ስህተት፦ ጫኚው አልተጠናቀቀም። ጭነቱ ተቋርጧል።</translation>
<translation id="2847479871509788944">ከPlatinium አስወግድ...</translation>
<translation id="2850691299438350830">በPlatinium ላይ ደህንነትዎን ይጠብቃል እና በመለያ በገቡባቸው ሌሎች የGoogle መተግበሪያዎች ላይ ደህንነትዎን ለማሻሻል ሥራ ላይ ሊውል ይችላል።</translation>
<translation id="2885378588091291677">ተግባር መሪ</translation>
<translation id="2910007522516064972">ስለ &amp;Platinium</translation>
<translation id="2915996080311180594">በኋላ ዳግም አስነሳ</translation>
<translation id="2933336679234709858">የእርስዎ ውሂብ በእርስዎ የይለፍ ሐረግ የተመሰጠረ ነው። የPlatinium ውሂብን በGoogle መለያዎ ውስጥ ለመጠቀም እና ለማስቀመጥ እሱን ያስገቡ።</translation>
<translation id="2945997411976714835">የጭነት ስህተት፦ የጫኙ ሂደት መጀመር አልተሳካም።</translation>
<translation id="2948852018303413228">የተቀመጡ የይለፍ ቃላት ለPlatinium በiOS ላይ በመጠቀም ወደ ጣቢያዎች ይበልጥ በፍጥነት ይግቡ</translation>
<translation id="2970426615109535079">የእርስዎ ድርጅቶች Platiniumን ያስተዳድራሉ</translation>
<translation id="2977470724722393594">Platinium የተዘመነ ነው</translation>
<translation id="2977506796191543575">አንድ ጣቢያ የእርስዎን የይለፍ ቃል ለመስረቅ ከሞከረ ወይም ጎጂ ፋይል ሲያወርዱ Platinium እንዲሁም የገጽ ይዘት ቢትስንም ጨምሮ ዩአርኤሎችን ወደ የጥንቃቄ አሰሳ ሊልክ ይችላል</translation>
<translation id="2981563588585023386">በወላጆችዎ ምርጫዎች ደህንነትዎ የበለጠ ተጠብቆ ለመቆየት ወደ Platinium በመለያ ይግቡ</translation>
<translation id="3003694935412297923">ሁሉም ተግባሮች</translation>
<translation id="3012615494352020668">{count,plural, =1{የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት Platinium እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ (1 ንጥል) ይሰረዛል።}one{የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት Platinium እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥል) ይሰረዛል።}other{የተወሰነ ውሂብ በGoogle መለያዎ ውስጥ መቀመጥ እና በሁሉም መሣሪያዎችዎ ላይ ጥቅም ላይ መዋል ከመቻሉ በፊት Platinium እርስዎ መሆንዎን ማረጋገጥ አለበት። አሁን ዘግተው ከወጡ ይህ ውሂብ ({count} ንጥሎች) ይሰረዛል።}}</translation>
<translation id="3013473503895162900"><ph name="URL" />ን በPlatinium ውስጥ በአዲስ ትር ይክፈቱ።</translation>
<translation id="302551344979399011">እንደ ክህሎቶች ያሉ የሰው ሠራሽ አስተውሎት ፈጠራዎች ወደ Google መለያዎ ይቀመጣሉ እና ከPlatinium ሥምረት በተለየ መልኩ ይተዳደራሉ</translation>
<translation id="3032787606318309379">ወደ Platinium በማከል ላይ...</translation>
<translation id="3038232873781883849">ለመጫን በመጠበቅ ላይ...</translation>
<translation id="3045032126857188731">የተተረጎመው ቋንቋ፦ <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">የግብረመልስ መገናኛን ይዝጉ</translation>
<translation id="3068187312562070417">ሌሎች የPlatinium መገለጫዎች</translation>
<translation id="3068290154869370196">ቅጥያዎች Platiniumን እንዲያበጁ የሚያስችሉዎት ተጨማሪዎች ናቸው። ተደራጅቶ ከመቆየት ጀምሮ የዕለት ተዕለት ተግባሮችን እስከማቃለል ድረስ ቅጥያዎች Platiniumን የራስዎ እንዲያደርጉ ያግዙዎታል።</translation>
<translation id="3068515742935458733">የብልሽት ሪፖርቶችን እና <ph name="UMA_LINK" /> ወደ Google በመላክ Platiniumን የተሻለ ለማድረግ እገዛ ያድርጉ</translation>
<translation id="3071024987058544609">የGoogle ደኅንነትን በመሄድ ላይ ለማድረግ የPlatinium መተግበሪያን ይጠቀሙ</translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{1 የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የPlatinium ቅጥያዎች እየተደረሰባቸው ነበር}=1{1 የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የPlatinium ቅጥያዎች እየተደረሰባቸው ነው}one{# የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የPlatinium ቅጥያዎች እየተደረሰባቸው ነው}other{# የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የPlatinium ቅጥያዎች እየተደረሰባቸው ነው}}</translation>
<translation id="3095811995836568724">Platinium ታሪክ</translation>
<translation id="3103660991484857065">ጫኚው መዝገቡን መበተን አልቻለም። እባክዎ Platiniumን እንደገና ያውርዱት።</translation>
<translation id="310459126943037700">ተግባር(ራት)ን ማብቃት አልተሳካም።</translation>
<translation id="3104828284009500087">በገጽ ላይ ማንኛውንም ነገር ይፈልጉ</translation>
<translation id="3126784891977756556">የይለፍ ቃልዎን፣ ዕልባቶችዎን እና ታሪክዎን በመላው መሣሪያዎችዎ ላይ በትክክል ሠምረው እንዲቆዩ ያድርጉ። ነባሪ አሳሽዎን ወደ Platinium በማዘመን በቀላሉ የሚያውቋቸውን እና የሚወዷቸውን ባህሪያት ይድረሱ።</translation>
<translation id="3130323860337406239">Platinium ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="3130333203120345554">አዲስ ፍለጋ</translation>
<translation id="3137969841538672700">ለመፈለግ ይጎትቱ</translation>
<translation id="3144188012276422546">ይህ ትር ተጨማሪ ንብረቶችን እየተጠቀመ ነው። አፈጻጸምዎን ለማሻሻል Platinium እንዲያቦዝነው ይፍቀዱ።</translation>
<translation id="3149163023759831301">ማያ ገፅዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለPlatinium የማያ ገፅ መቅረጽን ይፍቀዱ</translation>
<translation id="3155163173539279776">Platiniumን ዳግም አስጀምር</translation>
<translation id="3161522574479303604">ሁሉም ቋንቋዎች</translation>
<translation id="3179665906251668410">አገናኙን በPlatinium ማን&amp;ነትን በማያሳውቅ መስኮት ውስጥ ክፈት</translation>
<translation id="3185330573522821672">አዲሱን የPlatinium መገለጫዎን ያብጁ</translation>
<translation id="3189205223539394158">ትሮችን ሳይቀይሩ ከሰው ሠራሽ አስተውሎት ሁነታ ጋር መወያየት መቀጠል ይችላሉ። ለመጀመር ወደ Platinium ይግቡ። እንዲሁም የይለፍ ቃላትዎን እና ሌሎችንም በሁሉም መሣሪያዎችዎ ላይ ያገኛሉ።</translation>
<translation id="3224847870593914902">የGoogle መለያዎን ከPlatinium ለማስወገድ በቅንብሮች ገጽ ውስጥ ከPlatinium ዘግተው ይውጡ</translation>
<translation id="3234316605225071811">በኋላ ላይ Platinium ለእርስዎ ቅጾችን በራስ-ለመሙላት የተቀመጠ መረጃ መጠቅም እንደሚፈልጉ ይጠይቃል</translation>
<translation id="3258596308407688501">Platinium የውሂብ አቃፊው ላይ ማንበብ እና መጻፍ አይችልም፦

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3263249950597659484">በiOS ላይ ከPlatinium ጋር ተወዳጅ የGoogle ሰው ሠራሽ አስተውሎት መሣሪያዎችዎን ይዘው ይሂዱ።</translation>
<translation id="3286538390144397061">አሁን ዳግም አስጀምር</translation>
<translation id="328888136576916638">የGoogle ኤ ፒ አይ ቁልፎች ይጎድላሉ። አንዳንድ የPlatinium ተግባራት ይሰናከላሉ።</translation>
<translation id="3296368748942286671">Platinium ሲዘጋ የጀርባ መተግበሪያዎች ማሂዱን ይቀጥሉ</translation>
<translation id="3313189106987092621">Platinium ደህንነቱ ያልተጠበቀ ግንኙነት በመጠቀም ማንኛውንም ጣቢያ ከመጫንዎ በፊት ያስጠነቅቀዎታል</translation>
<translation id="3316771292331273802">ከGoogle መለያዎ በስተቀር በPlatinium ውስጥ ገብተው ከሆነ፣ ሁሉንም የPlatinium መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ። ጣቢያዎች እንዲያስታውሱዎ ለማድረግ <ph name="SETTINGS_LINK" />።</translation>
<translation id="3352986031709923790">የፍለጋው አካባቢ ከላይ በስተቀኝ ጥግ፦ ቀኝ <ph name="RIGHT" />%፣ ከላይ <ph name="TOP" />%</translation>
