<translation id="7213008767289637091">በማንኛውም ጊዜ Platiniumን በቀላሉ ማግኘት እንዲችሉ በእርስዎ መትከያ ውስጥ ያቆዩት</translation>
<translation id="7213407614656404070">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ Platinium ይጠቀሙ</translation>
<translation id="7216228761061470870">በዴስክቶፕ ላይ የምስል ፍለጋን ሲጠቀሙ የገጹ ርዕስ፣ ዩአርኤል እና PDFዎችን ጨምሮ ይዘት ወደ አገልጋዩ ይላካሉ</translation>
<translation id="7223968959479464213">ተግባር መሪ - Platinium</translation>
<translation id="7252276985725323153">በቅጽበት ማሰስ ይጀምሩ፦ አሁን Windows ሲጀምር Platinium መጀመር ይችላል።</translation>
<translation id="7274695763216404502">ፒን ተደርጓል! ከመሣሪያ አሞሌው እንደገና የምስል ፍለጋ ይጠቀሙ</translation>
<translation id="7288567540154601580">ትሮች እና ቅጥያዎች</translation>
<translation id="7295544978856094497">{NUM_EXTENSIONS,plural, =1{Platinium እንዲያስወግዱት ይመክራል}one{Platinium እንዲያስወግዱት ይመክራል}other{Platinium እንዲያስወግዷቸው ይመክራል}}</translation>
<translation id="7296334833518879294">የሥርዓት ኦዲዮን ለማጋራት የሥርዓት ቅንብሮችን ይክፈቱ እና ለPlatinium «የሥርዓት የኦዲዮ ቀረጻ ብቻ» ይፍቀዱ። ከዚያ Platiniumን እንደገና ማስጀመር ይኖርብዎታል።</translation>
<translation id="7309928523159922338">የማስታወቂያ ልኬት እርስዎ የሚጎበኟቸው ጣቢያዎች የማስታወቂያዎቻቸውን አፈጻጸም የሚለካው ጣቢያ የሚያግዘውን መረጃ ከPlatinium እንዲጠይቁ ያስችላቸዋል። የማስታወቂያ ልኬት በተቻለ መጠን ትንሽ መረጃን በጣቢያዎች መካከል በማስተላለፍ የጣቢያ ተሻጋሪ ክትትልን ይገድባል።</translation>
<translation id="731795002583552498">Platiniumን በማዘመን ላይ...</translation>
<translation id="7318036098707714271">የምርጫዎች ፋይልዎ የተበላሸ ወይም ልክ ያልሆነ ነው።

Platinium ቅንብሮችዎን ማስመለስ አልቻለም።</translation>
<translation id="734373864078049451">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የPlatinium ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="7347827960336370838">የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ Google አይላክም ወይም በGoogle አይከማችም። የእርስዎን የይለፍ ሐረግ ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን Platinium ውሂብ መሰረዝ<ph name="END_LINK" /> ይኖርብዎታል።</translation>
<translation id="7349591376906416160">የእርስዎ ስርዓት አስተዳዳሪ Platinium <ph name="TARGET_URL_HOSTNAME" />ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME" />ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7352651011704765696">የሆነ ችግር ተፈጥሯል</translation>
<translation id="7368826207863345663">የወደፊት የPlatinium ዝማኔዎችን ለማግኘት macOS 13 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር macOS 12 እየተጠቀመ ነው።</translation>
<translation id="7376384068949534168">በቅርብ ጊዜ አልጎበኙም። Platinium <ph name="PERMISSION_1" />፣ <ph name="PERMISSION_2" />ን አስወግዷል።</translation>
<translation id="73786666777299047">Chrome የድር መደብርን ይክፈቱ</translation>
<translation id="7407655596887111931">Platinium አሁን የእርስዎ ነባሪ አሳሽ ነው</translation>
<translation id="7413153308467572558">ካቆሙበት ይቀጥሉ፦ Platinium እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት ይመልሳል። ይህን ለማጥፋት ወደሚከተለው ይሂዱ</translation>
<translation id="7427879960656355200">የይለፍ ቃላትን ወደ Platinium ያምጡ</translation>
